#jinja2: lstrip_blocks: True, trim_blocks: True
---
# Pinned borgmatic 2.x schema. JSON scalars preserve secrets and path quoting.
source_directories: {{ borg_source_directories | to_json }}
one_file_system: {{ borg_one_file_system | to_json }}
repositories:
{% if borg_repository is string %}
  - path: {{ borg_repository | to_json }}
{% else %}
{% for repo in borg_repository %}
{% if repo is mapping %}
  - {{ repo | to_json }}
{% else %}
  - path: {{ repo | to_json }}
{% endif %}
{% endfor %}
{% endif %}
atime: {{ borgmatic_store_atime | to_json }}
ctime: {{ borgmatic_store_ctime | to_json }}
exclude_patterns: {{ borg_exclude_patterns | to_json }}
exclude_from: {{ borg_exclude_from | to_json }}
exclude_caches: true
exclude_if_present: [".nobackup"]
local_path: /opt/borgmatic/bin/borg
{% if borg_remote_path %}
remote_path: {{ borg_remote_path | to_json }}
{% endif %}
{% if borg_encryption_passphrase or not borg_encryption_passcommand %}
encryption_passphrase: {{ borg_encryption_passphrase | to_json }}
{% endif %}
{% if borg_encryption_passcommand %}
encryption_passcommand: {{ borg_encryption_passcommand | to_json }}
{% endif %}
compression: auto,zstd
{% if borg_remote_rate_limit %}
remote_rate_limit: {{ borg_remote_rate_limit | to_json }}
{% endif %}
{% if borg_ssh_command %}
ssh_command: {{ borg_ssh_command | to_json }}
{% endif %}
umask: 77
lock_wait: {{ borg_lock_wait_time | to_json }}
archive_name_format: '{hostname}-{now:%Y-%m-%d-%H%M%S}'
match_archives: 'sh:{hostname}-*'
relocated_repo_access_is_ok: {{ borgmatic_relocated_repo_access_is_ok | to_json }}
{% for key, value in borg_retention_policy.items() %}
{{ key }}: {{ value | to_json }}
{% endfor %}
checks:
{% for check in borgmatic_checks %}
  - {{ (check if check is mapping else {'name': check}) | to_json }}
{% endfor %}
check_last: {{ borgmatic_check_last | to_json }}
{% if borgmatic_mariadb_databases %}
mariadb_databases: {{ borgmatic_mariadb_databases | to_json }}
{% endif %}
{% if borgmatic_hooks or borgmatic_commands %}
commands:
{% for hook, commands in borgmatic_hooks.items() %}
{% if hook == 'before_backup' %}
  - before: configuration
    when: [create]
    run: {{ commands | to_json }}
{% elif hook == 'after_backup' %}
  - after: configuration
    when: [create]
    states: [finish]
    run: {{ commands | to_json }}
{% elif hook == 'on_error' %}
  - after: configuration
    states: [fail]
    run: {{ commands | to_json }}
{% endif %}
{% endfor %}
{% for command in borgmatic_commands %}
  - {{ command | to_json }}
{% endfor %}
{% else %}
commands: []
{% endif %}
